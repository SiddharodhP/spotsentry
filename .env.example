# Local MinIO credentials. Copied to .env by `python scripts/setup_local.py`,
# which replaces the password with a random one. .env is git-ignored.
MINIO_ROOT_USER=spotsentry
MINIO_ROOT_PASSWORD=change-me-local-only
# The MinIO server image. Official images were withdrawn when the project was archived.
MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z
